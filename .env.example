# =============================================================================
# .env — configuração do túnel autossh (copie para .env e edite)
#   cp .env.example .env
# =============================================================================

# --- Imagem -----------------------------------------------------------------
AUTOSSH_IMAGE=autossh:1.0

# --- Autenticação SSH (senha via sshpass) ------------------------------------
SSH_HOST=192.168.2.9
SSH_PORT=22
SSH_USER=kali
# senha do usuário SSH no host remoto (obrigatória)
SSH_PASSWORD=troque-pela-senha
# senha do usuário SSH no host remoto (obrigatória)

# --- Túneis (formato ssh: -R/-L/-D) ------------------------------------------
# Exemplos:
#   TUNNELS=-R 8282:localhost:8282
#   TUNNELS=-R 8282:0.0.0.0:8282 -R 5432:localhost:5432
TUNNELS=-R 8282:localhost:8282

# --- Resiliência / monitoramento ---------------------------------------------
AUTOSSH_GATETIME=0        # 0 = não desiste, reabre o túnel para sempre
AUTOSSH_POLL=30           # segundos entre testes de tráfego na porta monitor
AUTOSSH_MONITOR_PORT=20001
SERVER_ALIVE_INTERVAL=10  # keepalive ssh (s)
SERVER_ALIVE_COUNT_MAX=3

# --- Limites de recursos ------------------------------------------------------
CPU_LIMIT=1
MEMORY_LIMIT=512M
