# =============================================================================
# .env — configuração do túnel autossh (copie para .env e edite)
#   cp .env.example .env
# =============================================================================

# --- Imagem -----------------------------------------------------------------
AUTOSSH_IMAGE=autossh:1.1

# --- Destino SSH --------------------------------------------------------------
SSH_HOST=192.168.2.9
SSH_PORT=22
SSH_USER=kali
# tempo (s) máximo para o TCP conectar antes de desistir da tentativa
SSH_CONNECT_TIMEOUT=10

# Autenticação: senha via sshpass OU chave (defina UMA das duas)
# senha do usuário SSH no host remoto
SSH_PASSWORD=troque-pela-senha
# alternativa com chave: monte a chave no container (ver docker-compose.yml)
# e defina o caminho interno, deixando SSH_PASSWORD vazio. Ex.:
# SSH_KEY_FILE=/ssh/key

# --- Túneis -------------------------------------------------------------------
# formato ssh: -R/-L/-D, pode ter vários; ex.:
# TUNNELS="-R 8282:0.0.0.0:8282 -R 5432:localhost:5432"
TUNNELS=-R 8282:localhost:8282

# Porta (lado remoto) usada pelo watchdog/healthcheck para sondar o túnel.
# Vazio = inferida automaticamente do primeiro -R dos TUNNELS.
TUNNEL_HEALTH_PORT=8282

# --- Resiliência / monitoramento ----------------------------------------------
# porta local usada pelo autossh para testar tráfego (-M)
AUTOSSH_MONITOR_PORT=20001
# 0 = nunca desiste, reabre o túnel para sempre
AUTOSSH_GATETIME=0
# segundos entre sondas de tráfego/watchdog
AUTOSSH_POLL=30
# keepalive ssh: detecta conexão morta em ~INTERVAL*COUNT_MAX segundos
SERVER_ALIVE_INTERVAL=10
SERVER_ALIVE_COUNT_MAX=3
# 1 = na inicialização, mata forward órfão ocupando a porta no remoto
AUTOSSH_CLEANUP_STALE=1
# falhas de sonda seguidas antes do auto-limpeza no remoto
WATCHDOG_FAIL_THRESHOLD=2
# o fuser precisa de root no remoto (sessões sshd não são visíveis ao próprio usuário);
# defina a senha sudo do usuário SSH, ou use CLEANUP_USE_SUDO=1 com sudoers NOPASSWD
REMOTE_SUDO_PASSWORD=
CLEANUP_USE_SUDO=0

# --- Log ----------------------------------------------------------------------
# ~5 MB: ao ultrapassar, o log é rotacionado para autossh.log.1
AUTOSSH_LOG_MAX_BYTES=5242880

# --- Limites de recursos --------------------------------------------------------
CPU_LIMIT=1
MEMORY_LIMIT=512M
